{
  "name": "project-usa",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/encrypt-events.mjs && nuxt generate",
    "dev": "node scripts/encrypt-events.mjs && nuxt dev",
    "dev:phone": "node scripts/encrypt-events.mjs && nuxt dev --host=0.0.0.0 --https",
    "generate": "node scripts/encrypt-events.mjs && nuxt generate",
    "encrypt": "node scripts/encrypt-events.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.4.1",
    "nuxt": "^4.5.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/eslint": "^1.16.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  }
}
